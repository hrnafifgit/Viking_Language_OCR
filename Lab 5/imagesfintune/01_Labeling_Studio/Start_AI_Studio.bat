@echo off
chcp 65001 > nul
title "Nabataean and Aramaic AI Labeling Studio"
echo ======================================================================
echo  استوديو التوسيم الذكي للنقوش النبطية والآرامية
echo  جاري التحقق من خادم الذكاء الاصطناعي...
echo ======================================================================

cd /d "%~dp0"

:: Check if AI service is already running
curl.exe -s http://127.0.0.1:5005/status > nul 2>&1
if %ERRORLEVEL% EQU 0 (
    echo [OK] خادم الذكاء الاصطناعي يعمل بالفعل على المنفذ 5005!
) else (
    echo [..] جاري إطلاق خدمة الذكاء الاصطناعي...
    start "AI_Auto_Label_Backend" /min python ai_service.py
    ping -n 3 127.0.0.1 > nul
)

echo [..] جاري فتح واجهة استوديو التوسيم في المتصفح...
start "" "http://127.0.0.1:5005"

echo ======================================================================
echo  استوديو التوسيم جاهز للعمل على: http://127.0.0.1:5005
echo ======================================================================
ping -n 4 127.0.0.1 > nul
